# Chave da API Exa para busca web
# Obtenha em https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# URL do servidor OpenCode (default: http://127.0.0.1:4096)
# Em Docker, usar: http://host.docker.internal:4096
OPENCODE_SERVER_URL=http://127.0.0.1:4096

# Senha do servidor OpenCode
OPENCODE_SERVER_PASSWORD=

# Usuario HTTP basic do OpenCode (default: opencode)
# OPENCODE_SERVER_USERNAME=opencode

# Modelo do OpenCode (formato: providerID/modelID)
# Exemplos: opencode/mimo-v2.5-free, opencode/qwen3.6-plus
# Se nao definido, o servidor usa o modelo padrao da configuracao
OPENCODE_MODEL=
